
{
  // Static-only Worker: Astro pre-renders everything at build time, so there is
  // no `main` entrypoint and no @astrojs/cloudflare adapter. Without this file,
  // `wrangler deploy` auto-detects Astro and tries to install the SSR adapter.
  "name": "above-hoarded-gold",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
